# Public CMS identifiers. Copy to .env.local and supply your existing project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Legacy NEXT_PUBLIC_SANITY_STUDIO_* keys remain supported.
# No base URL is needed: static generation reads Sanity directly.

# Contact: public key must be present at build time; all other values are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Use an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=david.magbee@me.com
# Exact browser origin (configure separately for local/preview/production).
CONTACT_SITE_ORIGIN=https://davidmagbee.com
